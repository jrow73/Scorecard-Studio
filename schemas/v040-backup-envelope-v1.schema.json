{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scorecard.studio/schemas/v040-backup-envelope-v1.schema.json",
  "title": "Scorecard Studio Backup Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "formatVersion",
    "backupId",
    "createdAtUtc",
    "source",
    "scope",
    "settings",
    "layouts",
    "pdfTemplates"
  ],
  "properties": {
    "format": {
      "const": "scorecard-studio-backup"
    },
    "formatVersion": {
      "const": 1
    },
    "backupId": {
      "type": "string",
      "minLength": 1
    },
    "createdAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicationVersion", "build", "storageDatabaseVersion"],
      "properties": {
        "applicationVersion": { "type": "string", "minLength": 1 },
        "build": { "type": "string", "minLength": 1 },
        "storageDatabaseVersion": { "type": "integer", "minimum": 1 }
      }
    },
    "scope": {
      "enum": ["complete", "singleLayout"]
    },
    "settings": {
      "type": "array",
      "items": { "$ref": "#/$defs/settingRecord" }
    },
    "layouts": {
      "type": "array",
      "items": { "$ref": "#/$defs/layoutRecord" }
    },
    "pdfTemplates": {
      "type": "array",
      "items": { "$ref": "#/$defs/pdfTemplateRecord" }
    }
  },
  "$defs": {
    "settingRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "value": {},
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "layoutRecord": {
      "type": "object",
      "required": ["id", "schemaVersion", "name", "pdfTemplateId"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "schemaVersion": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1 },
        "pdfTemplateId": { "type": "string", "minLength": 1 }
      }
    },
    "pdfTemplateRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name", "type", "size", "data"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "type": { "const": "application/pdf" },
        "size": { "type": "integer", "minimum": 0 },
        "updatedAt": { "type": "string", "format": "date-time" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["encoding", "value", "sha256"],
          "properties": {
            "encoding": { "const": "base64" },
            "value": {
              "type": "string",
              "contentEncoding": "base64",
              "contentMediaType": "application/pdf"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{64}$"
            }
          }
        }
      }
    }
  }
}
